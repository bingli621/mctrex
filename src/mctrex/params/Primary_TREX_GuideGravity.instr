ROTATED (0, 0.000000000, 0) RELATIVE Guide_47

COMPONENT Guide_49 = Guide_gravity(
    w1=0.035667, h1=0.046092, w2=0.022761, h2=0.035233,
    l=2.930000, mleft=2, mright=2, mtop=4.5, mbottom=4.5,
    G=0)
AT (0, 0, 1.0+1e-6) RELATIVE Guide_48b
ROTATED (0, 0.000000000, 0) RELATIVE Guide_48b

COMPONENT MonochromatingChopper1 = DiskChopper(
    radius  = 0.35,
    yheight = 0.045,           
    theta_0 = M_slit,
    nu      = f*RRM*0.5,            
    nslit   = 1,
    delay   = tof_M1
)
AT (0, 0, 2.93+65e-3) RELATIVE Guide_49
ROTATED (0, 0.000000000, 0) RELATIVE Guide_49

COMPONENT MonochromatingChopper2 = DiskChopper(
    radius  = 0.35,
    yheight = 0.045,           
    theta_0 = M_slit,
    nu      = -f*RRM,            
    nslit   = 1,
    delay   = tof_M2
)
AT (0, 0, 10e-3) RELATIVE MonochromatingChopper1
ROTATED (0, 0.000000000, 0) RELATIVE MonochromatingChopper1

/* Sits 1 um after MC2 at 162.005 m, so setM (framed with L_M2) is correct. */
COMPONENT M_monitor_ToF_cm2 = Monitor_nD(
    options=setM,
    xwidth = 0.01, yheight = 0.01,
    filename = "M_monitor_tof_1cm2.dat",
    restore_neutron=1)
AT (0, 0, 1E-6) RELATIVE MonochromatingChopper2


//Primary guide only. Will add the collimators back soon.
COMPONENT Guide_50a = Guide_gravity(
    w1=0.022761, h1=0.035233, w2=0.013540, h2=0.029204,
    l=1.080000, mleft=3.5, mright=3.5, mtop=4.5, mbottom=4.5,
    G=0)
AT (0, 0, 65.0e-3 - 1E-6) RELATIVE M_monitor_ToF_cm2
ROTATED (0, 0.000000000, 0) RELATIVE M_monitor_ToF_cm2


/*-----------Sample Position-----------------------------------------------------*/
COMPONENT Sample_pos = Arm()
AT (0, 0, 1.080000 + 650e-3) RELATIVE Guide_50a      /* Guide_50a exit + 650 mm -> 163.800 m */
ROTATED (0, 0, 0) RELATIVE Guide_50a

COMPONENT at_sample_monitor_ToF_cm2 = Monitor_nD(
    options=setS,
    xwidth = 0.01, yheight = 0.01,
    filename = "sample_monitor_tof_1cm2_ToO_Coarse.dat",
    restore_neutron=1)
AT (0, 0, 1e-6) RELATIVE PREVIOUS

COMPONENT sample_monitor_xy = Monitor_nD(
    options="x limits [-0.05:0.05] bins = 101, y limits [-0.025:0.025] bins = 101",
    xwidth = 0.1, yheight = 0.05,
    filename = "sample_monitor_xy.dat",
    restore_neutron=1)
AT (0, 0, 1e-6) RELATIVE PREVIOUS

COMPONENT sample_monitor_hdiv = Monitor_nD(
    options="hdiv limits [-2.0:2.0] bins = 101",
    xwidth = 0.055, yheight = 0.075,
    filename = "sample_monitor_hdiv.dat",
    restore_neutron=1)
AT (0, 0, 1E-6) RELATIVE PREVIOUS

COMPONENT sample_monitor_vdiv = Monitor_nD(
    options="vdiv limits [-2.0:2.0] bins = 101",
    xwidth = 0.055, yheight = 0.075,
    filename = "sample_monitor_vdiv.dat",
    restore_neutron=1)
AT (0, 0, 1E-6) RELATIVE PREVIOUS

END